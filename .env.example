# ============================================================
#  Coolbox — variables de entorno para la conexión a SQL Server
#  Copia este archivo a ".env" y completa con tus datos reales.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# Host donde corre SQL Server. Para conexiones remotas usa la IP LAN
# de la PC servidor, por ejemplo 192.168.1.50
DB_HOST=localhost

# Puerto de SQL Server (por defecto 1433; SQL Express a veces usa 1433 o 1434)
DB_PORT=1433

# Nombre de la base de datos
DB_NAME=CoolboxDB

# Credenciales — crea un login SQL dedicado con permisos sobre CoolboxDB
# (no uses 'sa' en producción)
DB_USER=coolbox_app
DB_PASSWORD=CambiaEsto123!

# Encriptación del canal: true solo si el servidor tiene certificado válido.
# En entorno académico/desarrollo dejar false.
DB_ENCRYPT=false
